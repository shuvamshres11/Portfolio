# Your Gmail address (the one sending the emails)
EMAIL_USER=shuvamshes11@gmail.com

# Gmail App Password — 16 characters, NO spaces
# How to get it: https://myaccount.google.com/apppasswords
# Steps: Google Account → Security → 2-Step Verification → App passwords
# App name: "Portfolio Contact" → Generate → copy the 16-char code
EMAIL_PASS=your_16_char_app_password_here

# Where notification emails will be delivered (your inbox)
EMAIL_TO=shuvamshes11@gmail.com

# Server port (optional, default is 3001)
PORT=3001
